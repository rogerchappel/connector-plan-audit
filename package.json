{
  "name": "connector-plan-audit",
  "version": "0.1.0",
  "description": "Audit connector action plans for dry-run coverage, approvals, credentials, rollback, and evidence.",
  "type": "module",
  "bin": {
    "connector-plan-audit": "./bin/cli.js"
  },
  "scripts": {
    "test": "node --test",
    "check": "node scripts/check.js",
    "smoke": "node bin/cli.js fixtures/connector-plan.md",
    "smoke:json": "node bin/cli.js fixtures/connector-plan.md --json",
    "package:smoke": "node scripts/package-smoke.js",
    "release:check": "npm run check && npm test && npm run smoke && npm run smoke:json && npm run package:smoke"
  },
  "keywords": [
    "agent-skill",
    "connector",
    "dry-run",
    "approval",
    "audit"
  ],
  "author": "Roger Chappell",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/connector-plan-audit.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/connector-plan-audit/issues"
  },
  "homepage": "https://github.com/rogerchappel/connector-plan-audit#readme",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "src",
    "docs",
    "examples",
    "fixtures",
    "scripts",
    "SKILL.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ]
}
